# Copy this file to .env and fill in your credentials. Do NOT commit .env to source control.
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback
# Optional: a pre-generated access token for quick testing
UPSTOX_ACCESS_TOKEN=optional_access_token_here
